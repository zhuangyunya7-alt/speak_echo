NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: used for signing / short-lived video URLs
SPEAKECHO_VIDEO_SIGNING_SECRET=

# Tencent COS: presigned URLs for private bucket (same account as uploader-desktop)
# Set bucket to private read; store standard URLs like https://{bucket}.cos.{region}.myqcloud.com/...
COS_SECRET_ID=
COS_SECRET_KEY=
# Optional: comma-separated bucket names allowed to sign (if set, other buckets ignored)
# COS_SIGN_ALLOWED_BUCKETS=speakecho-xxxx
# TTL for signed links in seconds (60–86400). Default 7200.
# COS_SIGN_EXPIRES_SEC=7200
# Set to 0 to disable signing even if credentials exist (e.g. public bucket dev)
# COS_SIGN_MEDIA=0

# Admin gate (comma-separated phones, without spaces)
SPEAKECHO_ADMIN_PHONES=

# If set, POST /api/publish-video must send header x-publish-token with this value
# (must match uploader-desktop data/config.json publish_api_token in production)
PUBLISH_API_TOKEN=

